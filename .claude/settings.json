{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx stylelint*)",
      "Bash(npx wrangler dev*)",
      "Bash(npx wrangler types*)",
      "Bash(npx wrangler tail*)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(qlmanage *)",
      "Bash(sips *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(npx wrangler delete*)",
      "Bash(npx wrangler secret delete*)",
      "Bash(npx neonctl branches delete*)",
      "Bash(neonctl branches delete*)",
      "mcp__neon__delete_project",
      "mcp__neon__delete_branch",
      "mcp__neon__reset_from_parent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking migration is not already applied"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 45,
            "statusMessage": "Checking the money and time rules"
          }
        ]
      }
    ]
  }
}
