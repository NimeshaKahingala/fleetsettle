{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Differs from every deployed Worker name, so a bare `wrangler deploy`
  // can never overwrite production (IG §9.4).
  "name": "fleetsettle-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // DATABASE_URL, WHATSAPP_TOKEN and WHATSAPP_PHONE_ID are secrets
  // (`wrangler secret put`), never vars — vars are plaintext in the deployed
  // bundle (TS §8, IG §9.4). Local dev reads DATABASE_URL from .dev.vars,
  // which is gitignored.
  "vars": {
    "ENVIRONMENT": "development",
    "ASGARDEO_ISSUER": "https://api.asgardeo.io/t/fleetsettle/oauth2/token",
    "ASGARDEO_JWKS_URL": "https://api.asgardeo.io/t/fleetsettle/oauth2/jwks",
    // The SPA's client id. `verifyAccessToken` checks this as `aud`, so it must
    // be the id of the app that ISSUED the token — a mismatch is an
    // undifferentiated 401 with nothing in the message to say why (IG §10.6).
    "ASGARDEO_AUDIENCE": "h8HJK3NgWyj6qPndmaKYrhh8d8Ma",
  },

  // KV/R2/Queue bindings (TS §8). The ids below are placeholders — nothing in
  // P0 reads or writes them yet (JWKS caching is P1, R2 attachments and the
  // message queue are much later), and `wrangler dev`'s local persistence
  // does not require them to name a real remote resource. They do before the
  // first `wrangler deploy` — provisioning the real namespace/bucket/queue in
  // Cloudflare is a deliberate step for whoever holds that account, not
  // something to fabricate here.
  "kv_namespaces": [{ "binding": "KV", "id": "todo-provision-before-deploy" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "todo-provision-before-deploy" }],
  "queues": {
    "producers": [{ "binding": "MESSAGE_QUEUE", "queue": "todo-provision-before-deploy" }],
  },

  // IG §13: the rate-limiting binding, not a database row per request.
  // namespace_id is just an account-unique integer picked in config, not a
  // resource created up front like the KV/R2/Queue ids above — confirmed by
  // running `wrangler dev` against this exact value. 100 requests / 60s per
  // IP is a first real number, not a placeholder, but it is a guess at a
  // reasonable abuse floor for a handful of users, not a tuned figure.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
  ],

  // TS §4/P13: `generate-day-cards` and `generate-billing-periods`, both
  // "daily" — one Cron Trigger firing both (src/scheduled.ts runs them in
  // sequence, each in its own try/catch). Cron syntax is UTC always; 20:30
  // UTC is 02:00 in Asia/Colombo (UTC+5:30), early morning, well before the
  // day's first confirm (CLAUDE.md → Time: every "today" in the handler
  // itself still goes through `businessToday()`, never the trigger's own
  // UTC firing instant).
  "triggers": { "crons": ["30 20 * * *"] },

  // Deployed environments (DEPLOYMENT.md). The top-level block above stays
  // untouched by either — `workers_dev: false` and the local-only `name`
  // are what keep a bare `wrangler deploy` from ever touching QA or
  // production (IG §9.4). `vars`, `kv_namespaces`, `r2_buckets`, `queues`
  // and `ratelimits` are non-inheritable in wrangler: every one of them
  // must be restated in full below, or the binding silently vanishes from
  // the deployed Worker.
  "env": {
    "qa": {
      "name": "fleetsettle-api-qa",
      "routes": [{ "pattern": "qa.fleetsettle.com/api/*", "zone_name": "fleetsettle.com" }],
      "vars": {
        "ENVIRONMENT": "preview",
        "ASGARDEO_ISSUER": "https://api.asgardeo.io/t/fleetsettle/oauth2/token",
        "ASGARDEO_JWKS_URL": "https://api.asgardeo.io/t/fleetsettle/oauth2/jwks",
        // Shares local dev's app registration (redirect URLs
        // https://qa.fleetsettle.com/auth/callback and
        // http://localhost:5173/auth/callback). Production uses a different
        // app entirely — see below.
        "ASGARDEO_AUDIENCE": "h8HJK3NgWyj6qPndmaKYrhh8d8Ma",
      },
      // fleetsettle-kv-qa / fleetsettle-attachments-qa / fleetsettle-messages-qa
      // (DEPLOYMENT.md "Progress" — all three provisioned and isolated from prod).
      "kv_namespaces": [{ "binding": "KV", "id": "1dfcd1efb71846e49f6da9756a64523e" }],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "fleetsettle-attachments-qa" }],
      "queues": {
        "producers": [{ "binding": "MESSAGE_QUEUE", "queue": "fleetsettle-messages-qa" }],
      },
      // namespace_id must differ from every other environment's — rate-limit
      // counters are shared account-wide per namespace_id, not per Worker
      // (confirmed against Cloudflare's docs, DEPLOYMENT.md step 4).
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      "triggers": { "crons": ["30 20 * * *"] },
      "observability": { "enabled": true },
    },
    "production": {
      "name": "fleetsettle-api",
      "routes": [{ "pattern": "fleetsettle.com/api/*", "zone_name": "fleetsettle.com" }],
      "vars": {
        "ENVIRONMENT": "production",
        "ASGARDEO_ISSUER": "https://api.asgardeo.io/t/fleetsettle/oauth2/token",
        "ASGARDEO_JWKS_URL": "https://api.asgardeo.io/t/fleetsettle/oauth2/jwks",
        // Production has its OWN Asgardeo app, separate from local/QA's —
        // a leaked or rotated QA client must never be able to mint a token
        // this Worker accepts.
        "ASGARDEO_AUDIENCE": "Xamk7r3_kvklplKYz3qz0KL2cdga",
      },
      // fleetsettle-kv / fleetsettle-attachments / fleetsettle-messages
      // (DEPLOYMENT.md "Progress" — all three provisioned, isolated from QA).
      "kv_namespaces": [{ "binding": "KV", "id": "1c639491546d48319637f67d6db77b5a" }],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "fleetsettle-attachments" }],
      "queues": {
        "producers": [{ "binding": "MESSAGE_QUEUE", "queue": "fleetsettle-messages" }],
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      "triggers": { "crons": ["30 20 * * *"] },
      "observability": { "enabled": true },
    },
  },
}
